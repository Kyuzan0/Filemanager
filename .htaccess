# File Manager - Root .htaccess
# Used when DocumentRoot is project root (shared hosting).
# In Docker, Apache DocumentRoot is public/ so this file is not used.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive paths
    RewriteRule ^(app|storage|bin|tests|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^(\.git|\.env|composer\.(json|lock)|package(-lock)?\.json) - [F,L]

    # Route everything else into public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
