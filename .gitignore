# =============================================================================
# File Manager - .gitignore
# =============================================================================

# Dependencies
vendor/
node_modules/

# Build artifacts
build/

# Storage directories (user data)
storage/files/*
storage/trash/*
storage/logs/*
storage/temp/*
storage/database/*
storage/thumbnails/*
storage/sessions/*
storage/7zip_info_cache.json

# Keep directory structure
!storage/files/.gitkeep
!storage/trash/.gitkeep
!storage/logs/.gitkeep
!storage/temp/.gitkeep
!storage/database/.gitkeep
!storage/thumbnails/.gitkeep

# Legacy paths (to be removed after migration)
file/*
logs/*
.trash/*

# Development
bak/
bak2/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# PHP
*.log
php_errors.log

# Environment
.env
.env.local

# Documentation
docs/

# Tool artifacts
.kilo/
.playwright-mcp/
.sisyphus/
.trash/